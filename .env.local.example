# Two Supabase projects — Test and Production — so testing never touches
# real data. The app switches between them at runtime via a cookie (see
# src/lib/env-config.ts); both sets of credentials must be present.
# Dashboard: Project Settings > API

NEXT_PUBLIC_SUPABASE_URL_TEST=
NEXT_PUBLIC_SUPABASE_ANON_KEY_TEST=

NEXT_PUBLIC_SUPABASE_URL_PROD=
NEXT_PUBLIC_SUPABASE_ANON_KEY_PROD=

# service_role key from the PROD project (Settings > API) — secret, bypasses
# RLS entirely. Server-only; used by the nightly backup cron route.
SUPABASE_SERVICE_ROLE_KEY_PROD=

# Authorizes src/app/api/cron/backup — Vercel automatically sends this value
# as "Authorization: Bearer <CRON_SECRET>" when it invokes a cron job, for
# any env var named exactly CRON_SECRET. Generate with: openssl rand -hex 32
CRON_SECRET=
